            <mxPoint x="440" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 异常处理到幂等记录表 -->
        <mxCell id="edge9" value="8. 更新幂等记录" style="endArrow=classic;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" edge="1" parent="1" source="exceptionHandler" target="idempotentTable">
