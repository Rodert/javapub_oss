          </mxGeometry>
        </mxCell>
        
        <!-- 幂等检查到业务处理 -->
        <mxCell id="edge6" value="5a. 首次处理" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;flowAnimation=1;" edge="1" parent="1" source="idempotentCheck" target="businessProcess">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
