        </mxCell>
        
        <!-- 异常处理 -->
        <mxCell id="exceptionHandler" value="异常处理&#xa;(重试/死信队列)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
