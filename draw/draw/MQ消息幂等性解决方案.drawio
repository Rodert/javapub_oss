        <!-- 消息ID生成到MQ -->
        <mxCell id="edge2" value="1. 生成唯一消息ID" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" edge="1" parent="1" source="msgIdGenerator" target="mq">
