            <mxPoint x="440" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 幂等检查到Redis -->
        <mxCell id="edge5" value="4. 检查消息ID" style="endArrow=classic;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" edge="1" parent="1" source="idempotentCheck" target="redisCache">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
