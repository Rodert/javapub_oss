          </mxGeometry>
        </mxCell>
        
        <!-- 业务处理到幂等记录表 -->
        <mxCell id="edge8" value="7. 记录处理状态" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;flowAnimation=1;" edge="1" parent="1" source="businessProcess" target="exceptionHandler">
