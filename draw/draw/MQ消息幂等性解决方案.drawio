        </mxCell>
        
        <!-- 幂等检查直接返回 -->
        <mxCell id="edge10" value="5b. 重复消息直接返回" style="dashed=1;endArrow=block;html=1;exitX=0;exitY=0;exitDx=0;exitDy=0;curved=1;flowAnimation=1;" edge="1" parent="1" source="idempotentCheck">
