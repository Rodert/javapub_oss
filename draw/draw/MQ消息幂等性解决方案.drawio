          </mxGeometry>
        </mxCell>
        
        <!-- MQ到消费者 -->
        <mxCell id="edge3" value="2. 消息投递" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" edge="1" parent="1" source="mq" target="consumer">
